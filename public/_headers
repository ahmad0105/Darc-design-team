# Cloudflare Workers Static Assets Caching & Performance Headers

# 1. Hashed assets generated by Vite (Immutable 1-Year Cache)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 2. Static Icons, Manifest & Media
/manifest.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-192.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# 3. HTML Shell (Instant Updates - Must Revalidate with ETag)
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# 4. Universal Security & Performance Headers
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
